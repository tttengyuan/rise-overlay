<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== 面板 ===== -->
    <Color x:Key="Colors.PanelBackground">#FF080C11</Color>
    <SolidColorBrush x:Key="Brushes.PanelBackground" Color="{StaticResource Colors.PanelBackground}" />
    <Color x:Key="Colors.PanelBorder">#FF1D2735</Color>
    <SolidColorBrush x:Key="Brushes.PanelBorder" Color="{StaticResource Colors.PanelBorder}" />
    <Color x:Key="Colors.PanelBorderSubtle">#FF15202B</Color>
    <SolidColorBrush x:Key="Brushes.PanelBorderSubtle" Color="{StaticResource Colors.PanelBorderSubtle}" />

    <!-- ===== 前景 ===== -->
    <Color x:Key="Colors.Foreground">#FF9FD6FF</Color>
    <SolidColorBrush x:Key="Brushes.Foreground" Color="{StaticResource Colors.Foreground}" />
    <Color x:Key="Colors.ForegroundMuted">#FF5E7C96</Color>
    <SolidColorBrush x:Key="Brushes.ForegroundMuted" Color="{StaticResource Colors.ForegroundMuted}" />

    <!-- ===== 强调色 ===== -->
    <Color x:Key="Colors.AccentTeal">#FF39FF88</Color>
    <SolidColorBrush x:Key="Brushes.AccentTeal" Color="{StaticResource Colors.AccentTeal}" />
    <Color x:Key="Colors.AccentHealth">#FF39FF88</Color>
    <SolidColorBrush x:Key="Brushes.AccentHealth" Color="#FF39FF88" />
    <Color x:Key="Colors.AccentQurio">#FFFF5D8F</Color>
    <SolidColorBrush x:Key="Brushes.AccentQurio" Color="{StaticResource Colors.AccentQurio}" />
    <LinearGradientBrush x:Key="Brushes.AccentSever" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#FF39FF88" Offset="0.0" />
            <GradientStop Color="#FF9DFF5D" Offset="1.0" />
    </LinearGradientBrush>
    <Color x:Key="Colors.AccentStun">#FFFFD54D</Color>
    <SolidColorBrush x:Key="Brushes.AccentStun" Color="{StaticResource Colors.AccentStun}" />
    <Color x:Key="Colors.AccentBreak">#FFFF8C42</Color>
    <SolidColorBrush x:Key="Brushes.AccentBreak" Color="{StaticResource Colors.AccentBreak}" />
    <Color x:Key="Colors.AccentCapture">#FF9DFFC4</Color>
    <SolidColorBrush x:Key="Brushes.AccentCapture" Color="{StaticResource Colors.AccentCapture}" />

    <!-- ===== 字体 / 圆角 ===== -->
    <sys:Double x:Key="Fonts.Size.Small">10</sys:Double>
    <sys:Double x:Key="Fonts.Size.Body">11</sys:Double>
    <sys:Double x:Key="Fonts.Size.Title">12</sys:Double>
    <FontFamily x:Key="Fonts.Family.Hud">Consolas</FontFamily>
    <CornerRadius x:Key="Theme.PanelCornerRadius">6</CornerRadius>

    <!-- ===== 元素色 ===== -->
    <Color x:Key="Colors.Element.Fire">#FFFF6B6B</Color>
    <SolidColorBrush x:Key="Brushes.Element.Fire" Color="{StaticResource Colors.Element.Fire}" />
    <Color x:Key="Colors.Element.Water">#FF5D9BFF</Color>
    <SolidColorBrush x:Key="Brushes.Element.Water" Color="{StaticResource Colors.Element.Water}" />
    <Color x:Key="Colors.Element.Thunder">#FFFFD54D</Color>
    <SolidColorBrush x:Key="Brushes.Element.Thunder" Color="{StaticResource Colors.Element.Thunder}" />
    <Color x:Key="Colors.Element.Ice">#FF7DD3FC</Color>
    <SolidColorBrush x:Key="Brushes.Element.Ice" Color="{StaticResource Colors.Element.Ice}" />
    <Color x:Key="Colors.Element.Dragon">#FFB06BFF</Color>
    <SolidColorBrush x:Key="Brushes.Element.Dragon" Color="{StaticResource Colors.Element.Dragon}" />
    <SolidColorBrush x:Key="Brushes.Element.Foreground" Color="#FF080C11" />

    <!-- ===== 皮肤层：面板发光 / 反光 / 纹理 / 切角 ===== -->
    <SolidColorBrush x:Key="Brushes.PanelGlow" Color="#FF39FF88" />
    <sys:Double x:Key="Theme.GlowOpacity">0.22</sys:Double>
    <LinearGradientBrush x:Key="Brushes.PanelGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="Theme.GlossOpacity">0.08</sys:Double>
    <DrawingBrush x:Key="Theme.PanelTexture" TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#4D000000">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,4,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <sys:Double x:Key="Theme.TextureOpacity">1.0</sys:Double>
    <sys:Double x:Key="Theme.CornerSlashOpacity">0.0</sys:Double>

    <!-- ===== 皮肤层：血条 ===== -->
    <LinearGradientBrush x:Key="Brushes.HpBarGloss" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="Theme.HpGlossOpacity">0.35</sys:Double>
    <sys:Double x:Key="Theme.HpHeight">11</sys:Double>

    <!-- ===== 色板外提：轨 / 槽 / 文本 ===== -->
    <SolidColorBrush x:Key="Brushes.RailTrack" Color="#FF131C26" />
    <SolidColorBrush x:Key="Brushes.FlinchFill" Color="#FF2A6F4A" />
    <SolidColorBrush x:Key="Brushes.RailBroken" Color="#FF26313D" />
    <SolidColorBrush x:Key="Brushes.RailDefault" Color="#FF39FF88" />
    <SolidColorBrush x:Key="Brushes.StatusText" Color="#FF8FD6FF" />
    <SolidColorBrush x:Key="Brushes.HpTrack" Color="#FF131C26" />
    <SolidColorBrush x:Key="Brushes.WeakenLine" Color="#FFEAFFEF" />
    <SolidColorBrush x:Key="Brushes.CaptureBorder" Color="#FF39FF88" />
    <SolidColorBrush x:Key="Brushes.CaptureFill" Color="#2639FF88" />
    <SolidColorBrush x:Key="Brushes.CaptureText" Color="#FF9DFFC4" />
    <!-- ===== 状态色块：引用本主题既有强调色，随主题自动跟随 ===== -->
    <SolidColorBrush x:Key="Brushes.StatusEnrage" Color="{StaticResource Colors.AccentBreak}" />
    <SolidColorBrush x:Key="Brushes.StatusStun" Color="{StaticResource Colors.AccentStun}" />
    <SolidColorBrush x:Key="Brushes.StatusStamina" Color="{StaticResource Colors.AccentTeal}" />
    <SolidColorBrush x:Key="Brushes.StatusRide" Color="{StaticResource Colors.AccentCapture}" />
    <SolidColorBrush x:Key="Brushes.StatusAilment" Color="{StaticResource Colors.AccentQurio}" />
</ResourceDictionary>
