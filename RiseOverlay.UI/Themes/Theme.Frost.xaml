<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== 面板 ===== -->
    <Color x:Key="Colors.PanelBackground">#FF0E1E2A</Color>
    <SolidColorBrush x:Key="Brushes.PanelBackground" Color="{StaticResource Colors.PanelBackground}" />
    <Color x:Key="Colors.PanelBorder">#4D96D7FF</Color>
    <SolidColorBrush x:Key="Brushes.PanelBorder" Color="{StaticResource Colors.PanelBorder}" />
    <Color x:Key="Colors.PanelBorderSubtle">#2696D7FF</Color>
    <SolidColorBrush x:Key="Brushes.PanelBorderSubtle" Color="{StaticResource Colors.PanelBorderSubtle}" />

    <!-- ===== 前景 ===== -->
    <Color x:Key="Colors.Foreground">#FFD6F0FF</Color>
    <SolidColorBrush x:Key="Brushes.Foreground" Color="{StaticResource Colors.Foreground}" />
    <Color x:Key="Colors.ForegroundMuted">#FF7FA6BF</Color>
    <SolidColorBrush x:Key="Brushes.ForegroundMuted" Color="{StaticResource Colors.ForegroundMuted}" />

    <!-- ===== 强调色 ===== -->
    <Color x:Key="Colors.AccentTeal">#FF8FD6FF</Color>
    <SolidColorBrush x:Key="Brushes.AccentTeal" Color="{StaticResource Colors.AccentTeal}" />
    <Color x:Key="Colors.AccentHealth">#FF6FC9FF</Color>
    <LinearGradientBrush x:Key="Brushes.AccentHealth" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#FF6FC9FF" Offset="0.0" />
            <GradientStop Color="#FFCDF2FF" Offset="1.0" />
    </LinearGradientBrush>
    <Color x:Key="Colors.AccentQurio">#FFFF7FB0</Color>
    <SolidColorBrush x:Key="Brushes.AccentQurio" Color="{StaticResource Colors.AccentQurio}" />
    <LinearGradientBrush x:Key="Brushes.AccentSever" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#FF8FD6FF" Offset="0.0" />
            <GradientStop Color="#FFCDF2FF" Offset="1.0" />
    </LinearGradientBrush>
    <Color x:Key="Colors.AccentStun">#FFFFE08F</Color>
    <SolidColorBrush x:Key="Brushes.AccentStun" Color="{StaticResource Colors.AccentStun}" />
    <Color x:Key="Colors.AccentBreak">#FFFFA98F</Color>
    <SolidColorBrush x:Key="Brushes.AccentBreak" Color="{StaticResource Colors.AccentBreak}" />
    <Color x:Key="Colors.AccentCapture">#FFCDF2FF</Color>
    <SolidColorBrush x:Key="Brushes.AccentCapture" Color="{StaticResource Colors.AccentCapture}" />

    <!-- ===== 字体 / 圆角 ===== -->
    <sys:Double x:Key="Fonts.Size.Small">10</sys:Double>
    <sys:Double x:Key="Fonts.Size.Body">11</sys:Double>
    <sys:Double x:Key="Fonts.Size.Title">12</sys:Double>
    <FontFamily x:Key="Fonts.Family.Hud">Segoe UI</FontFamily>
    <CornerRadius x:Key="Theme.PanelCornerRadius">9</CornerRadius>

    <!-- ===== 元素色 ===== -->
    <Color x:Key="Colors.Element.Fire">#FFFF8A8A</Color>
    <SolidColorBrush x:Key="Brushes.Element.Fire" Color="{StaticResource Colors.Element.Fire}" />
    <Color x:Key="Colors.Element.Water">#FF6FC9FF</Color>
    <SolidColorBrush x:Key="Brushes.Element.Water" Color="{StaticResource Colors.Element.Water}" />
    <Color x:Key="Colors.Element.Thunder">#FFFFE08F</Color>
    <SolidColorBrush x:Key="Brushes.Element.Thunder" Color="{StaticResource Colors.Element.Thunder}" />
    <Color x:Key="Colors.Element.Ice">#FFCDF2FF</Color>
    <SolidColorBrush x:Key="Brushes.Element.Ice" Color="{StaticResource Colors.Element.Ice}" />
    <Color x:Key="Colors.Element.Dragon">#FFB08FFF</Color>
    <SolidColorBrush x:Key="Brushes.Element.Dragon" Color="{StaticResource Colors.Element.Dragon}" />
    <SolidColorBrush x:Key="Brushes.Element.Foreground" Color="#FF0A1A24" />

    <!-- ===== 皮肤层：面板发光 / 反光 / 纹理 / 切角 ===== -->
    <SolidColorBrush x:Key="Brushes.PanelGlow" Color="#FF6FC9FF" />
    <sys:Double x:Key="Theme.GlowOpacity">0.35</sys:Double>
    <LinearGradientBrush x:Key="Brushes.PanelGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="Theme.GlossOpacity">0.18</sys:Double>
    <DrawingBrush x:Key="Theme.PanelTexture" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#66BFE8FF">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1.5,1.5" RadiusX="1" RadiusY="1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <sys:Double x:Key="Theme.TextureOpacity">0.9</sys:Double>
    <sys:Double x:Key="Theme.CornerSlashOpacity">0.0</sys:Double>

    <!-- ===== 皮肤层：血条 ===== -->
    <LinearGradientBrush x:Key="Brushes.HpBarGloss" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="Theme.HpGlossOpacity">0.8</sys:Double>
    <sys:Double x:Key="Theme.HpHeight">10</sys:Double>

    <!-- ===== 色板外提：轨 / 槽 / 文本 ===== -->
    <SolidColorBrush x:Key="Brushes.RailTrack" Color="#FF0A1A24" />
    <SolidColorBrush x:Key="Brushes.FlinchFill" Color="#FFB4E1FF" />
    <SolidColorBrush x:Key="Brushes.RailBroken" Color="#FF2A4256" />
    <SolidColorBrush x:Key="Brushes.RailDefault" Color="#FF8FD6FF" />
    <SolidColorBrush x:Key="Brushes.StatusText" Color="#FFBFE3FF" />
    <SolidColorBrush x:Key="Brushes.HpTrack" Color="#FF0A1A24" />
    <SolidColorBrush x:Key="Brushes.WeakenLine" Color="#FFEAF8FF" />
    <SolidColorBrush x:Key="Brushes.CaptureBorder" Color="#FF96D7FF" />
    <SolidColorBrush x:Key="Brushes.CaptureFill" Color="#2696D7FF" />
    <SolidColorBrush x:Key="Brushes.CaptureText" Color="#FFCDF2FF" />
    <!-- ===== 状态色块：引用本主题既有强调色，随主题自动跟随 ===== -->
    <SolidColorBrush x:Key="Brushes.StatusEnrage" Color="{StaticResource Colors.AccentBreak}" />
    <SolidColorBrush x:Key="Brushes.StatusStun" Color="{StaticResource Colors.AccentStun}" />
    <SolidColorBrush x:Key="Brushes.StatusStamina" Color="{StaticResource Colors.AccentTeal}" />
    <SolidColorBrush x:Key="Brushes.StatusRide" Color="{StaticResource Colors.AccentCapture}" />
    <SolidColorBrush x:Key="Brushes.StatusAilment" Color="{StaticResource Colors.AccentQurio}" />
</ResourceDictionary>
