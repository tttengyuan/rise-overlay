<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="Colors.PanelBackground">#F2FFFDF8</Color>
    <SolidColorBrush x:Key="Brushes.PanelBackground" Color="{StaticResource Colors.PanelBackground}" />
    <Color x:Key="Colors.PanelBorder">#FFD7CFC0</Color>
    <SolidColorBrush x:Key="Brushes.PanelBorder" Color="{StaticResource Colors.PanelBorder}" />
    <Color x:Key="Colors.PanelBorderSubtle">#FFE7E0D4</Color>
    <SolidColorBrush x:Key="Brushes.PanelBorderSubtle" Color="{StaticResource Colors.PanelBorderSubtle}" />
    <Color x:Key="Colors.Foreground">#FF2D3340</Color>
    <SolidColorBrush x:Key="Brushes.Foreground" Color="{StaticResource Colors.Foreground}" />
    <Color x:Key="Colors.ForegroundMuted">#FF8A8580</Color>
    <SolidColorBrush x:Key="Brushes.ForegroundMuted" Color="{StaticResource Colors.ForegroundMuted}" />
    <Color x:Key="Colors.AccentTeal">#FF6BB3C2</Color>
    <SolidColorBrush x:Key="Brushes.AccentTeal" Color="{StaticResource Colors.AccentTeal}" />
    <Color x:Key="Colors.AccentHealth">#FFEF6B7B</Color>
    <SolidColorBrush x:Key="Brushes.AccentHealth" Color="{StaticResource Colors.AccentHealth}" />
    <Color x:Key="Colors.AccentQurio">#FFBE123C</Color>
    <SolidColorBrush x:Key="Brushes.AccentQurio" Color="{StaticResource Colors.AccentQurio}" />
    <LinearGradientBrush x:Key="Brushes.AccentSever" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFF08A4B" Offset="0" />
        <GradientStop Color="#FFF4A261" Offset="1" />
    </LinearGradientBrush>
    <Color x:Key="Colors.AccentStun">#FFA67C3A</Color>
    <SolidColorBrush x:Key="Brushes.AccentStun" Color="{StaticResource Colors.AccentStun}" />
    <Color x:Key="Colors.AccentBreak">#FFF08A4B</Color>
    <SolidColorBrush x:Key="Brushes.AccentBreak" Color="{StaticResource Colors.AccentBreak}" />
    <Color x:Key="Colors.AccentCapture">#FFB4234C</Color>
    <SolidColorBrush x:Key="Brushes.AccentCapture" Color="{StaticResource Colors.AccentCapture}" />
    <sys:Double x:Key="Fonts.Size.Small">10</sys:Double>
    <sys:Double x:Key="Fonts.Size.Body">11</sys:Double>
    <sys:Double x:Key="Fonts.Size.Title">12</sys:Double>
    <CornerRadius x:Key="Theme.PanelCornerRadius">10</CornerRadius>
    <Color x:Key="Colors.Element.Fire">#FFB4234C</Color>
    <SolidColorBrush x:Key="Brushes.Element.Fire" Color="{StaticResource Colors.Element.Fire}" />
    <Color x:Key="Colors.Element.Water">#FF0369A1</Color>
    <SolidColorBrush x:Key="Brushes.Element.Water" Color="{StaticResource Colors.Element.Water}" />
    <Color x:Key="Colors.Element.Thunder">#FFA16207</Color>
    <SolidColorBrush x:Key="Brushes.Element.Thunder" Color="{StaticResource Colors.Element.Thunder}" />
    <Color x:Key="Colors.Element.Ice">#FF0E7490</Color>
    <SolidColorBrush x:Key="Brushes.Element.Ice" Color="{StaticResource Colors.Element.Ice}" />
    <Color x:Key="Colors.Element.Dragon">#FF6D28D9</Color>
    <SolidColorBrush x:Key="Brushes.Element.Dragon" Color="{StaticResource Colors.Element.Dragon}" />
    <SolidColorBrush x:Key="Brushes.Element.Foreground" Color="White" />

    <!-- ===== 皮肤层（中性默认：不改变原有观感） ===== -->
    <SolidColorBrush x:Key="Brushes.PanelGlow" Color="#00000000" />
    <sys:Double x:Key="Theme.GlowOpacity">0</sys:Double>
    <LinearGradientBrush x:Key="Brushes.PanelGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="Theme.GlossOpacity">0</sys:Double>
    <SolidColorBrush x:Key="Theme.PanelTexture" Color="#00000000" />
    <sys:Double x:Key="Theme.TextureOpacity">0</sys:Double>
    <sys:Double x:Key="Theme.CornerSlashOpacity">0</sys:Double>
    <LinearGradientBrush x:Key="Brushes.HpBarGloss" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="Theme.HpGlossOpacity">0</sys:Double>
    <sys:Double x:Key="Theme.HpHeight">8</sys:Double>
    <FontFamily x:Key="Fonts.Family.Hud">Segoe UI</FontFamily>

    <!-- ===== 色板外提（沿用原硬编码值） ===== -->
    <SolidColorBrush x:Key="Brushes.RailTrack" Color="#FF1A222C" />
    <SolidColorBrush x:Key="Brushes.FlinchFill" Color="#FFB8C0CC" />
    <SolidColorBrush x:Key="Brushes.RailBroken" Color="#FF596466" />
    <SolidColorBrush x:Key="Brushes.RailDefault" Color="#FFB8995F" />
    <SolidColorBrush x:Key="Brushes.StatusText" Color="#FFD0B778" />
    <SolidColorBrush x:Key="Brushes.HpTrack" Color="#FF1A222C" />
    <SolidColorBrush x:Key="Brushes.WeakenLine" Color="#FFFFF1F2" />
    <SolidColorBrush x:Key="Brushes.CaptureBorder" Color="#FFC9AA62" />
    <SolidColorBrush x:Key="Brushes.CaptureFill" Color="#24B8995F" />
    <SolidColorBrush x:Key="Brushes.CaptureText" Color="#FFE2CA87" />
    <!-- ===== 状态色块：引用本主题既有强调色，随主题自动跟随 ===== -->
    <SolidColorBrush x:Key="Brushes.StatusEnrage" Color="{StaticResource Colors.AccentBreak}" />
    <SolidColorBrush x:Key="Brushes.StatusStun" Color="{StaticResource Colors.AccentStun}" />
    <SolidColorBrush x:Key="Brushes.StatusStamina" Color="{StaticResource Colors.AccentTeal}" />
    <SolidColorBrush x:Key="Brushes.StatusRide" Color="{StaticResource Colors.AccentCapture}" />
    <SolidColorBrush x:Key="Brushes.StatusAilment" Color="{StaticResource Colors.AccentQurio}" />
</ResourceDictionary>
