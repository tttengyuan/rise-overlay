<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== 面板 ===== -->
    <Color x:Key="Colors.PanelBackground">#F20A1018</Color>
    <SolidColorBrush x:Key="Brushes.PanelBackground" Color="{StaticResource Colors.PanelBackground}" />
    <Color x:Key="Colors.PanelBorder">#5900E5FF</Color>
    <SolidColorBrush x:Key="Brushes.PanelBorder" Color="{StaticResource Colors.PanelBorder}" />
    <Color x:Key="Colors.PanelBorderSubtle">#2600E5FF</Color>
    <SolidColorBrush x:Key="Brushes.PanelBorderSubtle" Color="{StaticResource Colors.PanelBorderSubtle}" />

    <!-- ===== 前景 ===== -->
    <Color x:Key="Colors.Foreground">#FFE8FBFF</Color>
    <SolidColorBrush x:Key="Brushes.Foreground" Color="{StaticResource Colors.Foreground}" />
    <Color x:Key="Colors.ForegroundMuted">#FF6E8FA3</Color>
    <SolidColorBrush x:Key="Brushes.ForegroundMuted" Color="{StaticResource Colors.ForegroundMuted}" />

    <!-- ===== 强调色 ===== -->
    <Color x:Key="Colors.AccentTeal">#FF00E5FF</Color>
    <SolidColorBrush x:Key="Brushes.AccentTeal" Color="{StaticResource Colors.AccentTeal}" />
    <Color x:Key="Colors.AccentHealth">#FF00E5FF</Color>
    <LinearGradientBrush x:Key="Brushes.AccentHealth" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#FF00E5FF" Offset="0.0" />
            <GradientStop Color="#FF7A5CFF" Offset="0.5" />
            <GradientStop Color="#FFFF2BD6" Offset="1.0" />
    </LinearGradientBrush>
    <Color x:Key="Colors.AccentQurio">#FFFF2BD6</Color>
    <SolidColorBrush x:Key="Brushes.AccentQurio" Color="{StaticResource Colors.AccentQurio}" />
    <LinearGradientBrush x:Key="Brushes.AccentSever" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#FF00E5FF" Offset="0.0" />
            <GradientStop Color="#FF7A5CFF" Offset="1.0" />
    </LinearGradientBrush>
    <Color x:Key="Colors.AccentStun">#FF7A5CFF</Color>
    <SolidColorBrush x:Key="Brushes.AccentStun" Color="{StaticResource Colors.AccentStun}" />
    <Color x:Key="Colors.AccentBreak">#FFFF8A3D</Color>
    <SolidColorBrush x:Key="Brushes.AccentBreak" Color="{StaticResource Colors.AccentBreak}" />
    <Color x:Key="Colors.AccentCapture">#FF7DE9FF</Color>
    <SolidColorBrush x:Key="Brushes.AccentCapture" Color="{StaticResource Colors.AccentCapture}" />

    <!-- ===== 字体 / 圆角 ===== -->
    <sys:Double x:Key="Fonts.Size.Small">10</sys:Double>
    <sys:Double x:Key="Fonts.Size.Body">11</sys:Double>
    <sys:Double x:Key="Fonts.Size.Title">12</sys:Double>
    <FontFamily x:Key="Fonts.Family.Hud">Consolas</FontFamily>
    <CornerRadius x:Key="Theme.PanelCornerRadius">2</CornerRadius>

    <!-- ===== 元素色 ===== -->
    <Color x:Key="Colors.Element.Fire">#FFFF2BD6</Color>
    <SolidColorBrush x:Key="Brushes.Element.Fire" Color="{StaticResource Colors.Element.Fire}" />
    <Color x:Key="Colors.Element.Water">#FF00E5FF</Color>
    <SolidColorBrush x:Key="Brushes.Element.Water" Color="{StaticResource Colors.Element.Water}" />
    <Color x:Key="Colors.Element.Thunder">#FF7A5CFF</Color>
    <SolidColorBrush x:Key="Brushes.Element.Thunder" Color="{StaticResource Colors.Element.Thunder}" />
    <Color x:Key="Colors.Element.Ice">#FF7DE9FF</Color>
    <SolidColorBrush x:Key="Brushes.Element.Ice" Color="{StaticResource Colors.Element.Ice}" />
    <Color x:Key="Colors.Element.Dragon">#FFB06BFF</Color>
    <SolidColorBrush x:Key="Brushes.Element.Dragon" Color="{StaticResource Colors.Element.Dragon}" />
    <SolidColorBrush x:Key="Brushes.Element.Foreground" Color="#FFFFFFFF" />

    <!-- ===== 皮肤层：面板发光 / 反光 / 纹理 / 切角 ===== -->
    <SolidColorBrush x:Key="Brushes.PanelGlow" Color="#FF00E5FF" />
    <sys:Double x:Key="Theme.GlowOpacity">0.55</sys:Double>
    <LinearGradientBrush x:Key="Brushes.PanelGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="Theme.GlossOpacity">0.10</sys:Double>
    <DrawingBrush x:Key="Theme.PanelTexture" TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#2600E5FF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,4,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <sys:Double x:Key="Theme.TextureOpacity">0.9</sys:Double>
    <sys:Double x:Key="Theme.CornerSlashOpacity">0.85</sys:Double>

    <!-- ===== 皮肤层：血条 ===== -->
    <LinearGradientBrush x:Key="Brushes.HpBarGloss" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="Theme.HpGlossOpacity">0.9</sys:Double>
    <sys:Double x:Key="Theme.HpHeight">9</sys:Double>

    <!-- ===== 色板外提：轨 / 槽 / 文本 ===== -->
    <SolidColorBrush x:Key="Brushes.RailTrack" Color="#FF08131C" />
    <SolidColorBrush x:Key="Brushes.FlinchFill" Color="#FF00E5FF" />
    <SolidColorBrush x:Key="Brushes.RailBroken" Color="#FF2A3A45" />
    <SolidColorBrush x:Key="Brushes.RailDefault" Color="#FF7A5CFF" />
    <SolidColorBrush x:Key="Brushes.StatusText" Color="#FFA9E9FF" />
    <SolidColorBrush x:Key="Brushes.HpTrack" Color="#FF061019" />
    <SolidColorBrush x:Key="Brushes.WeakenLine" Color="#FFE8FBFF" />
    <SolidColorBrush x:Key="Brushes.CaptureBorder" Color="#FF00E5FF" />
    <SolidColorBrush x:Key="Brushes.CaptureFill" Color="#3300E5FF" />
    <SolidColorBrush x:Key="Brushes.CaptureText" Color="#FF7DE9FF" />
    <!-- ===== 状态色块：引用本主题既有强调色，随主题自动跟随 ===== -->
    <SolidColorBrush x:Key="Brushes.StatusEnrage" Color="{StaticResource Colors.AccentBreak}" />
    <SolidColorBrush x:Key="Brushes.StatusStun" Color="{StaticResource Colors.AccentStun}" />
    <SolidColorBrush x:Key="Brushes.StatusStamina" Color="{StaticResource Colors.AccentTeal}" />
    <SolidColorBrush x:Key="Brushes.StatusRide" Color="{StaticResource Colors.AccentCapture}" />
    <SolidColorBrush x:Key="Brushes.StatusAilment" Color="{StaticResource Colors.AccentQurio}" />
</ResourceDictionary>
