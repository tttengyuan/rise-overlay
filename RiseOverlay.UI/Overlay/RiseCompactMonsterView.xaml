<overlay:Widget x:Class="RiseOverlay.UI.Overlay.RiseCompactMonsterView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:overlay="clr-namespace:HunterPie.UI.Overlay;assembly=HunterPie.UI"
                xmlns:local="clr-namespace:RiseOverlay.UI.Overlay"
                xmlns:views="clr-namespace:RiseOverlay.UI.Views"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance Type=local:RiseCompactMonsterViewModel}"
                Width="300">
    <overlay:Widget.Resources>
        <ResourceDictionary />
    </overlay:Widget.Resources>
    <Grid Visibility="{Binding ContentVisibility, Mode=OneWay}">
        <!-- Attached stub: always proves the overlay window is rendering -->
        <Border Visibility="{Binding AttachedVisibility, Mode=OneWay}"
                Background="{DynamicResource Brushes.PanelBackground}"
                BorderBrush="{DynamicResource Brushes.PanelBorder}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="8,6">
            <TextBlock Text="Rise血条 · 已附加"
                       Foreground="{StaticResource Brushes.ForegroundMuted}"
                       FontSize="{StaticResource Fonts.Size.Body}"
                       TextWrapping="NoWrap" />
        </Border>
        <Grid Visibility="{Binding BriefingVisibility, Mode=OneWay}">
            <views:QuestBriefingView DataContext="{Binding QuestBriefing}" />
        </Grid>
        <views:CombatStackView x:Name="CombatStack"
                               DataContext="{Binding}"
                               Visibility="{Binding CombatVisibility, Mode=OneWay}" />
    </Grid>
</overlay:Widget>
