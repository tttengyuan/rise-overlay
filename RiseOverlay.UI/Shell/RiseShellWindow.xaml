<Window x:Class="RiseOverlay.UI.Shell.RiseShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rise血条"
        Width="600"
        Height="460"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#FF080A0E"
        Foreground="#FFEEF0F4"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/RiseOverlay.UI;component/Resources/rise-hp-icon.png">
    <Window.Resources>
        <SolidColorBrush x:Key="Shell.Surface" Color="#FF0F1319" />
        <SolidColorBrush x:Key="Shell.Card" Color="#FF12171F" />
        <SolidColorBrush x:Key="Shell.Stroke" Color="#FF252B36" />
        <SolidColorBrush x:Key="Shell.Muted" Color="#FF8B93A1" />
        <SolidColorBrush x:Key="Shell.Dim" Color="#FF6B7382" />
        <SolidColorBrush x:Key="Shell.Accent" Color="#FF4A9B9B" />
        <SolidColorBrush x:Key="Shell.AccentSoft" Color="#FF5ECFC4" />
        <SolidColorBrush x:Key="Shell.Danger" Color="#FFFFB4C0" />
        <SolidColorBrush x:Key="Shell.Select" Color="#FFFF4D6D" />
        <SolidColorBrush x:Key="Shell.Button" Color="#FF181E28" />
        <SolidColorBrush x:Key="Shell.TrackOff" Color="#FF2A303C" />

        <Style x:Key="Shell.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Shell.Muted}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Shell.Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Shell.Dim}" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style x:Key="Shell.CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Shell.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Shell.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="Shell.SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Shell.Button}" />
            <Setter Property="Foreground" Value="#FFEEF0F4" />
            <Setter Property="BorderBrush" Value="#FF2A303C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1E2633" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Shell.AccentButton" TargetType="Button" BasedOn="{StaticResource Shell.SecondaryButton}">
            <Setter Property="Background" Value="#FF1A3030" />
            <Setter Property="Foreground" Value="{StaticResource Shell.AccentSoft}" />
            <Setter Property="BorderBrush" Value="#FF3A6B6B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF214040" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4A9B9B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch (CheckBox) -->
        <Style x:Key="Shell.Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FFEEF0F4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <ContentPresenter RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                            <Border x:Name="Track"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="{StaticResource Shell.TrackOff}"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb"
                                         Width="16"
                                         Height="16"
                                         Fill="#FFC5CAD3"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Shell.Accent}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip toggle for HUD content -->
        <Style x:Key="Shell.Chip" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Shell.Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip"
                                Background="#FF182028"
                                BorderBrush="#FF2A303C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6,8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Shell.Accent}" />
                                <Setter Property="Foreground" Value="#FFEEF0F4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#FF1A2830" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Padding="16,14,16,12"
            Background="{StaticResource Shell.Surface}"
            BorderBrush="#FF2A303C"
            BorderThickness="1"
            CornerRadius="16">
        <DockPanel LastChildFill="True">
            <!-- Footer -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="True">
                <Button x:Name="ExitButton"
                        DockPanel.Dock="Right"
                        Content="退出程序"
                        MinWidth="88"
                        Margin="12,0,0,0"
                        Padding="14,7"
                        Click="OnExitClick"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="{StaticResource Shell.Danger}"
                        Background="#FF1A1418"
                        BorderBrush="#FF3A3038"
                        BorderThickness="1"
                        ToolTip="彻底退出（点窗口关闭会最小化到托盘）">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF24181C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="Ctrl+Alt+O 开关叠层 · ScrLk 调位置"
                           FontSize="11"
                           Foreground="{StaticResource Shell.Dim}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14" LastChildFill="True">
                <Border x:Name="StatusPill"
                        DockPanel.Dock="Right"
                        Background="#1A4A9B9B"
                        BorderBrush="#484A9B9B"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="7"
                                 Height="7"
                                 Fill="#FF6B7280"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="等待游戏…"
                                   FontSize="11"
                                   Foreground="{StaticResource Shell.AccentSoft}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button x:Name="CheckUpdateButton"
                        DockPanel.Dock="Right"
                        Content="检查更新"
                        Style="{StaticResource Shell.AccentButton}"
                        VerticalAlignment="Center"
                        Click="OnCheckUpdateClick"
                        ToolTip="从 GitHub Releases 检查并安装新版本（国内可能需要 VPN）" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34"
                            Height="18"
                            CornerRadius="5"
                            BorderBrush="#FF2A303C"
                            BorderThickness="1"
                            Background="#FF151A22"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Padding="3">
                        <Border CornerRadius="2"
                                Background="#FF4A9B9B"
                                HorizontalAlignment="Left"
                                Width="20" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Rise血条"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="Monster Hunter Rise · 紧凑战斗 HUD"
                                   FontSize="11"
                                   Foreground="{StaticResource Shell.Muted}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Two columns -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,6,0">
                    <StackPanel>
                        <Border Style="{StaticResource Shell.CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="叠层" Style="{StaticResource Shell.SectionLabel}" />
                                <CheckBox x:Name="OverlayToggle"
                                          Style="{StaticResource Shell.Toggle}"
                                          Margin="0,0,0,8"
                                          Checked="OnOverlayToggle"
                                          Unchecked="OnOverlayToggle">
                                    <StackPanel>
                                        <TextBlock Text="显示叠层" FontSize="12" Foreground="#FFEEF0F4" />
                                        <TextBlock Text="Ctrl+Alt+O" Style="{StaticResource Shell.Hint}" />
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Height="1" Fill="#FF1C2230" Margin="0,0,0,8" />
                                <CheckBox x:Name="DesignModeToggle"
                                          Style="{StaticResource Shell.Toggle}"
                                          Margin="0,0,0,8"
                                          Checked="OnDesignModeToggle"
                                          Unchecked="OnDesignModeToggle">
                                    <StackPanel>
                                        <TextBlock Text="调整位置" FontSize="12" Foreground="#FFEEF0F4" />
                                        <TextBlock Text="可拖出窗外，再关锁定 · ScrLk"
                                                   Style="{StaticResource Shell.Hint}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                                <Button x:Name="ResetPositionButton"
                                        Content="复位叠层位置"
                                        Style="{StaticResource Shell.SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Click="OnResetPositionClick"
                                        ToolTip="叠层飞出屏幕时点这里拉回左上角" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Shell.CardStyle}">
                            <StackPanel>
                                <TextBlock Text="战斗 HUD" Style="{StaticResource Shell.SectionLabel}" />
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <CheckBox x:Name="ShowPartsToggle"
                                              Content="部位"
                                              Style="{StaticResource Shell.Chip}"
                                              Margin="0,0,4,0"
                                              Checked="OnHudDisplayToggle"
                                              Unchecked="OnHudDisplayToggle" />
                                    <CheckBox x:Name="ShowAilmentsToggle"
                                              Content="异常"
                                              Style="{StaticResource Shell.Chip}"
                                              Margin="2,0,2,0"
                                              Checked="OnHudDisplayToggle"
                                              Unchecked="OnHudDisplayToggle" />
                                    <CheckBox x:Name="ShowDpsToggle"
                                              Content="DPS"
                                              Style="{StaticResource Shell.Chip}"
                                              Margin="4,0,0,0"
                                              Checked="OnHudDisplayToggle"
                                              Unchecked="OnHudDisplayToggle" />
                                </UniformGrid>
                                <CheckBox x:Name="CombatMotionToggle"
                                          Style="{StaticResource Shell.Toggle}"
                                          Checked="OnHudDisplayToggle"
                                          Unchecked="OnHudDisplayToggle">
                                    <StackPanel>
                                        <TextBlock Text="战斗动效" FontSize="12" Foreground="#FFEEF0F4" />
                                        <TextBlock Text="虚弱 / 晕眩 / 破部位 / 弱属性"
                                                   Style="{StaticResource Shell.Hint}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: themes -->
                <Border Grid.Column="1"
                        Style="{StaticResource Shell.CardStyle}"
                        Margin="6,0,0,0">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="立即生效并记住"
                                       FontSize="10"
                                       Foreground="{StaticResource Shell.Dim}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="HUD 主题" Style="{StaticResource Shell.SectionLabel}" Margin="0" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <UniformGrid x:Name="ThemeGrid" Columns="2" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
