<Window x:Class="RiseOverlay.UI.Shell.RiseShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rise血条"
        Width="380"
        Height="620"
        MinWidth="340"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A0E16"
        Foreground="#FFFFFFFF"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/RiseOverlay.UI;component/Resources/rise-hp-icon.png">
    <Border Margin="12"
            Padding="14,12"
            Background="#F20A0E16"
            BorderBrush="#FF2A2F38"
            BorderThickness="1"
            CornerRadius="2">
        <DockPanel LastChildFill="True">
            <!-- Footer: dock Exit first so it keeps full width; text fills the rest. -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="True">
                <Button x:Name="ExitButton"
                        DockPanel.Dock="Right"
                        Content="退出程序"
                        Padding="14,5"
                        Margin="12,0,0,0"
                        MinWidth="88"
                        Click="OnExitClick"
                        Background="#FF151922"
                        Foreground="#FFFFFFFF"
                        BorderBrush="#FF2A2F38"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="彻底退出（点窗口关闭会最小化到托盘）" />
                <TextBlock Text="Ctrl+Alt+O 开关叠层 · ScrLk 也可调位置"
                           FontSize="11"
                           Foreground="#FF9AA3B2"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,4,0" />
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,0">
            <StackPanel>
                <!-- Brand row: mini HP bar mark + name -->
                <DockPanel Margin="0,0,0,10" LastChildFill="False">
                    <Border Width="28" Height="14"
                            CornerRadius="2"
                            BorderBrush="#FF2A2F38"
                            BorderThickness="1"
                            Background="#FF151922"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <Border Margin="2"
                                CornerRadius="1"
                                Background="#FF4A9B9B"
                                HorizontalAlignment="Left"
                                Width="18" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Rise血条"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFFFF" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="Monster Hunter Rise · 紧凑战斗 HUD"
                                   FontSize="11"
                                   Foreground="#FF9AA3B2"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Status strip -->
                <Border Background="#FF12161E"
                        BorderBrush="#FF22262E"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="10,8"
                        Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="8" Height="8"
                                 Fill="#FF6B7280"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="等待游戏…"
                                   FontSize="12"
                                   Foreground="#FF9AA3B2"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="OverlayToggle"
                          Content="显示叠层"
                          Foreground="#FFFFFFFF"
                          FontSize="12"
                          Checked="OnOverlayToggle"
                          Unchecked="OnOverlayToggle" />

                <CheckBox x:Name="DesignModeToggle"
                          Content="调整位置（可拖到游戏窗外，再关一次锁定）"
                          Foreground="#FFFFFFFF"
                          FontSize="12"
                          Margin="0,8,0,0"
                          Checked="OnDesignModeToggle"
                          Unchecked="OnDesignModeToggle" />

                <Button x:Name="ResetPositionButton"
                        Content="复位叠层位置"
                        Margin="0,8,0,0"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        Click="OnResetPositionClick"
                        Background="#FF151922"
                        Foreground="#FFFFFFFF"
                        BorderBrush="#FF2A2F38"
                        Cursor="Hand"
                        ToolTip="叠层飞出屏幕时点这里拉回左上角" />

                <TextBlock Text="战斗 HUD 内容"
                           FontSize="11"
                           Foreground="#FF9AA3B2"
                           Margin="0,12,0,4" />

                <CheckBox x:Name="ShowPartsToggle"
                          Content="显示部位"
                          Foreground="#FFFFFFFF"
                          FontSize="12"
                          Margin="0,2,0,0"
                          Checked="OnHudDisplayToggle"
                          Unchecked="OnHudDisplayToggle" />

                <CheckBox x:Name="ShowAilmentsToggle"
                          Content="显示异常"
                          Foreground="#FFFFFFFF"
                          FontSize="12"
                          Margin="0,4,0,0"
                          Checked="OnHudDisplayToggle"
                          Unchecked="OnHudDisplayToggle" />

                <CheckBox x:Name="ShowDpsToggle"
                          Content="显示 DPS"
                          Foreground="#FFFFFFFF"
                          FontSize="12"
                          Margin="0,4,0,0"
                          Checked="OnHudDisplayToggle"
                          Unchecked="OnHudDisplayToggle" />

                <TextBlock Text="HUD 主题"
                           FontSize="11"
                           Foreground="#FF9AA3B2"
                           Margin="0,12,0,4" />
                <TextBlock Text="选择后立即生效并记住，下次打开自动恢复"
                           FontSize="10"
                           Foreground="#FF6B7280"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap" />
                <UniformGrid x:Name="ThemeGrid"
                             Columns="2"
                             Margin="0,0,0,4" />

                <CheckBox x:Name="CombatMotionToggle"
                          Content="战斗动效（虚弱 / 晕眩 / 破部位 / 推荐弱属性）"
                          Foreground="#FFFFFFFF"
                          FontSize="12"
                          Margin="0,8,0,0"
                          Checked="OnHudDisplayToggle"
                          Unchecked="OnHudDisplayToggle" />

                <TextBlock Text="更新"
                           FontSize="11"
                           Foreground="#FF9AA3B2"
                           Margin="0,12,0,4" />

                <Button x:Name="CheckUpdateButton"
                        Content="检查更新"
                        Margin="0,0,0,0"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        Click="OnCheckUpdateClick"
                        Background="#FF151922"
                        Foreground="#FFFFFFFF"
                        BorderBrush="#FF2A2F38"
                        Cursor="Hand"
                        ToolTip="从 GitHub Releases 检查并安装新版本（国内可能需要 VPN）" />
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
