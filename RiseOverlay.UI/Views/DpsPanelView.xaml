<UserControl x:Class="RiseOverlay.UI.Views.DpsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RiseOverlay.UI.ViewModels"
             Width="300"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="CartCounterTemplate">
            <Border Padding="4,0"
                    CornerRadius="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brushes.AccentHealth}">
                <TextBlock Text="{Binding}"
                           Foreground="{DynamicResource Brushes.AccentHealth}"
                           FontSize="{DynamicResource Fonts.Size.Small}"
                           FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="QuestLimitsTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TimeRemainingText}"
                           Margin="0,0,6,0"
                           Foreground="{DynamicResource Brushes.ForegroundMuted}"
                           FontSize="{DynamicResource Fonts.Size.Small}"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center"
                           Visibility="{Binding ShowTimeRemaining, Converter={StaticResource BoolToVis}}" />
                <ContentControl Content="{Binding CartCounterText}"
                                ContentTemplate="{StaticResource CartCounterTemplate}"
                                Visibility="{Binding ShowCartCounter, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DpsEntryRowViewModel}">
            <Border Padding="4,1"
                    Margin="0,1,0,0"
                    CornerRadius="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                <Setter Property="Background" Value="#1A4A9B9B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" MinWidth="48" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="Auto" MinWidth="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Index}"
                               Foreground="{DynamicResource Brushes.ForegroundMuted}"
                               FontSize="{DynamicResource Fonts.Size.Small}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="{DynamicResource Fonts.Size.Small}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brushes.ForegroundMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.Column="2"
                            Height="3"
                            VerticalAlignment="Center"
                            Background="#1A222C"
                            CornerRadius="1"
                            Margin="0,0,6,0">
                        <Border Background="{DynamicResource Brushes.AccentTeal}"
                                CornerRadius="1"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ShareRatio}" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>

                    <TextBlock Grid.Column="3"
                               Text="{Binding DpsText}"
                               Foreground="{DynamicResource Brushes.ForegroundMuted}"
                               FontSize="{DynamicResource Fonts.Size.Small}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Margin="0,0,6,0" />

                    <TextBlock Grid.Column="4"
                               Text="{Binding TotalDamageText}"
                               FontSize="{DynamicResource Fonts.Size.Body}"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center"
                               TextAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brushes.AccentTeal}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brushes.PanelBackground}"
            Padding="8,4"
            CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            BorderBrush="{DynamicResource Brushes.PanelBorder}"
            BorderThickness="1">
        <Grid>
            <!-- Solo: one compact line -->
            <Grid Visibility="{Binding IsSolo, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SoloLineText}"
                           Foreground="{DynamicResource Brushes.Foreground}"
                           FontSize="{DynamicResource Fonts.Size.Body}"
                           Typography.NumeralAlignment="Tabular"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <ContentControl Grid.Column="1"
                                Margin="6,0,0,0"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource QuestLimitsTemplate}" />
            </Grid>

            <!-- Party: time/total + flat rows（怪名已在 HUD，不再重复「当前目标」） -->
            <StackPanel Visibility="{Binding IsParty, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource QuestLimitsTemplate}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding PartyTotalText}"
                               Foreground="{DynamicResource Brushes.ForegroundMuted}"
                               FontSize="{DynamicResource Fonts.Size.Small}"
                               Typography.NumeralAlignment="Tabular"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Entries}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
