<UserControl x:Class="RiseOverlay.UI.Views.DpsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RiseOverlay.UI.ViewModels"
             Width="272"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RiseOverlay.UI;component/Themes/CompactTeal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:DpsEntryRowViewModel}">
            <Border Padding="4,1"
                    Margin="0,1,0,0"
                    CornerRadius="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                <Setter Property="Background" Value="#1A4A9B9B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" MinWidth="48" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="Auto" MinWidth="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Index}"
                               Foreground="{StaticResource Brushes.ForegroundMuted}"
                               FontSize="{StaticResource Fonts.Size.Small}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="{StaticResource Fonts.Size.Small}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brushes.ForegroundMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brushes.Foreground}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.Column="2"
                            Height="3"
                            VerticalAlignment="Center"
                            Background="#1A222C"
                            CornerRadius="1"
                            Margin="0,0,6,0">
                        <Border Background="{StaticResource Brushes.AccentTeal}"
                                CornerRadius="1"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ShareRatio}" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>

                    <TextBlock Grid.Column="3"
                               Text="{Binding DpsText}"
                               Foreground="{StaticResource Brushes.ForegroundMuted}"
                               FontSize="{StaticResource Fonts.Size.Small}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Margin="0,0,6,0" />

                    <TextBlock Grid.Column="4"
                               Text="{Binding TotalDamageText}"
                               FontSize="{StaticResource Fonts.Size.Body}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brushes.Foreground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brushes.AccentTeal}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource Brushes.PanelBackground}"
            Padding="8,4"
            CornerRadius="2"
            BorderBrush="{StaticResource Brushes.PanelBorder}"
            BorderThickness="1">
        <Grid>
            <!-- Solo: one compact line -->
            <TextBlock Text="{Binding SoloLineText}"
                       Foreground="{StaticResource Brushes.Foreground}"
                       FontSize="{StaticResource Fonts.Size.Body}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsSolo, Converter={StaticResource BoolToVis}}" />

            <!-- Party: header + flat rows -->
            <StackPanel Visibility="{Binding IsParty, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="大型目标累计"
                               Foreground="{StaticResource Brushes.ForegroundMuted}"
                               FontSize="{StaticResource Fonts.Size.Small}"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding PartyTotalText}"
                               Foreground="{StaticResource Brushes.ForegroundMuted}"
                               FontSize="{StaticResource Fonts.Size.Small}"
                               HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Entries}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
