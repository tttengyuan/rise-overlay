<UserControl x:Class="RiseOverlay.UI.Views.MonsterHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RiseOverlay.UI.Controls"
             xmlns:converters="clr-namespace:RiseOverlay.UI.Converters"
             xmlns:domain="clr-namespace:RiseOverlay.Domain;assembly=RiseOverlay.Domain"
             xmlns:vm="clr-namespace:RiseOverlay.UI.ViewModels"
             Width="272"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RiseOverlay.UI;component/Themes/CompactTeal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:FractionToLeftMarginConverter x:Key="FractionToLeftMargin" />

        <DataTemplate DataType="{x:Type vm:ElementDisplayItem}">
            <controls:ElementChip Element="{Binding Element}"
                                  Dimmed="{Binding IsDimmed}"
                                  Margin="0,0,3,0" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PartRowViewModel}">
            <Grid Margin="0,2,0,0" Opacity="{Binding RowOpacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="36" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 4px status rail: gold=break, orange=sever, red=Qurio, grey=complete. -->
                <Border Grid.Column="0" CornerRadius="1" Margin="0,2,0,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFB8995F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSeverable}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brushes.AccentSever}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                    <Setter Property="Background" Value="#FF596466" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsQurio}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brushes.AccentQurio}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           FontSize="{StaticResource Fonts.Size.Small}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="5,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brushes.ForegroundMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecommendedTarget}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brushes.Foreground}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsQurio}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brushes.AccentQurio}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           FontSize="9"
                           VerticalAlignment="Center"
                           Margin="3,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFD0B778" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brushes.ForegroundMuted}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsQurio}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brushes.AccentQurio}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Visibility="{Binding HasWeakElements, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding WeakElements}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ElementChip Element="{Binding}"
                                                      Small="True"
                                                      Margin="0,0,2,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Column="4"
                        Height="4"
                        VerticalAlignment="Center"
                        Background="#1A222C"
                        CornerRadius="1"
                        Margin="0,0,4,0"
                        Visibility="{Binding ShowActiveBar, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="1"
                            RenderTransformOrigin="0,0.5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Brushes.AccentTeal}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeverable}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brushes.AccentSever}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsQurio}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brushes.AccentQurio}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding HealthRatio}" />
                        </Border.RenderTransform>
                    </Border>
                </Border>

                <!-- Completed parts keep their row/weakness but no longer look actionable. -->
                <Border Grid.Column="4"
                        Height="1"
                        VerticalAlignment="Center"
                        Background="#FF596466"
                        Margin="0,0,4,0"
                        Opacity="0.8"
                        Visibility="{Binding ShowCompletedLine, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Column="5"
                           Text="{Binding HealthText}"
                           Foreground="{StaticResource Brushes.ForegroundMuted}"
                           FontSize="9"
                           VerticalAlignment="Center"
                           MinWidth="52"
                           TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="PanelRoot"
            Background="{StaticResource Brushes.PanelBackground}"
            Padding="8,6"
            CornerRadius="2"
            BorderThickness="1">
        <Border.BorderBrush>
            <SolidColorBrush x:Name="PanelBorderBrush" Color="#FF2A2F38" />
        </Border.BorderBrush>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CaptureBannerVisible}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="CapturePulse">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                     From="#FF725E39"
                                                     To="#FFC9AA62"
                                                    Duration="0:0:1.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="CapturePulse" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <!-- 1. Capture banner -->
            <Border Visibility="{Binding CaptureBannerVisible, Converter={StaticResource BoolToVis}}"
                    BorderBrush="#FFC9AA62"
                    BorderThickness="1"
                    Background="#24B8995F"
                    CornerRadius="2"
                    Padding="6,2"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="可捕获"
                           Foreground="#FFE2CA87"
                           FontSize="{StaticResource Fonts.Size.Body}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </Border>

            <!-- 2. Title -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           Foreground="{StaticResource Brushes.Foreground}"
                           FontSize="{StaticResource Fonts.Size.Title}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        CornerRadius="2"
                        Padding="4,1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding CaptureBadgeVisible, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#26333A44" />
                            <Setter Property="BorderBrush" Value="#303F4854" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CaptureBadgeIsCapturable}" Value="True">
                                    <Setter Property="Background" Value="#24B8995F" />
                                    <Setter Property="BorderBrush" Value="#55B8995F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CaptureBadgeIsAnomaly}" Value="True">
                                    <Setter Property="Background" Value="#24E11D48" />
                                    <Setter Property="BorderBrush" Value="#66E11D48" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding CaptureBadgeText}"
                               FontSize="9">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brushes.ForegroundMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CaptureBadgeIsCapturable}" Value="True">
                                        <Setter Property="Foreground" Value="#FFE0C77F" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CaptureBadgeIsAnomaly}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFF8A80" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{Binding HealthPercentText}"
                           Foreground="{StaticResource Brushes.Foreground}"
                           FontSize="{StaticResource Fonts.Size.Body}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 3. Weakness + Recommend -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="弱"
                           Foreground="{StaticResource Brushes.ForegroundMuted}"
                           FontSize="{StaticResource Fonts.Size.Small}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding OverallElements}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Grid.Column="2"
                           Text="推荐"
                           Foreground="{StaticResource Brushes.ForegroundMuted}"
                           FontSize="{StaticResource Fonts.Size.Small}"
                           VerticalAlignment="Center"
                           Margin="6,0,4,0" />
                <ItemsControl Grid.Column="3"
                              ItemsSource="{Binding Recommended}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ElementChip Element="{Binding}" Margin="0,0,3,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- 4. HP bar + weaken line (主血条始终红色；部位条另用青色) -->
            <Border x:Name="HpTrack"
                    Height="8"
                    Background="#1A222C"
                    CornerRadius="2"
                    Margin="0,0,0,3"
                    ClipToBounds="True">
                <Grid>
                    <Border Background="{StaticResource Brushes.AccentHealth}"
                            CornerRadius="2"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding HealthRatio}" />
                        </Border.RenderTransform>
                    </Border>
                    <Border Width="2"
                            Height="8"
                            HorizontalAlignment="Left"
                            Background="#FFFFF1F2"
                            Visibility="{Binding WeakenLineVisible, Converter={StaticResource BoolToVis}}">
                        <Border.Margin>
                            <MultiBinding Converter="{StaticResource FractionToLeftMargin}">
                                <Binding Path="WeakenLinePosition" />
                                <Binding Path="ActualWidth" ElementName="HpTrack" />
                            </MultiBinding>
                        </Border.Margin>
                    </Border>
                </Grid>
            </Border>

            <!-- 5. Numbers -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding HealthNumbersText}"
                           Foreground="{StaticResource Brushes.ForegroundMuted}"
                           FontSize="{StaticResource Fonts.Size.Small}" />
                <TextBlock Grid.Column="1"
                           Text="已过虚弱线"
                           Foreground="{StaticResource Brushes.AccentHealth}"
                           FontSize="{StaticResource Fonts.Size.Small}"
                           Visibility="{Binding PastWeakenLine, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- 6. Status + active stun chip -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,6,0"
                        Padding="5,1"
                        CornerRadius="2"
                        BorderThickness="1"
                        BorderBrush="{StaticResource Brushes.AccentStun}"
                        Background="#33EAB308"
                        VerticalAlignment="Center"
                        Visibility="{Binding StunActive, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StunActive}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="StunPulseBoard">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.42"
                                                                 Duration="0:0:0.45" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="StunPulseBoard" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="晕眩中"
                                   Foreground="{StaticResource Brushes.AccentStun}"
                                   FontSize="{StaticResource Fonts.Size.Small}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StunCountdownText}"
                                   Foreground="#FFFFF7CC"
                                   FontSize="{StaticResource Fonts.Size.Body}"
                                   FontWeight="Bold"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   MinWidth="28" />
                    </StackPanel>
                </Border>

                <controls:StatusLineText Grid.Column="1"
                                         Text="{Binding StatusLineText}"
                                         VerticalAlignment="Center" />
            </Grid>

            <!-- 7. Parts -->
            <StackPanel Visibility="{Binding ShowParts, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="部位 · 状态 · 弱属性 · 剩余值"
                           Foreground="{StaticResource Brushes.ForegroundMuted}"
                           FontSize="9"
                           Margin="0,0,0,2" />
                <ItemsControl ItemsSource="{Binding Parts}" Margin="0,0,0,6" />
            </StackPanel>

            <!-- 8. Ailments: one dense text line, no progress bars. -->
            <TextBlock Text="{Binding AilmentsLineText}"
                       Foreground="{StaticResource Brushes.ForegroundMuted}"
                       FontSize="{StaticResource Fonts.Size.Small}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding ShowAilmentsLine, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</UserControl>
