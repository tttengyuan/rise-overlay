<UserControl x:Class="RiseOverlay.UI.Views.MonsterHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RiseOverlay.UI.Controls"
             xmlns:converters="clr-namespace:RiseOverlay.UI.Converters"
             xmlns:domain="clr-namespace:RiseOverlay.Domain;assembly=RiseOverlay.Domain"
             xmlns:vm="clr-namespace:RiseOverlay.UI.ViewModels"
             Width="300"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:FractionToLeftMarginConverter x:Key="FractionToLeftMargin" />

        <DataTemplate DataType="{x:Type vm:ElementDisplayItem}">
            <controls:ElementChip Element="{Binding Element}"
                                  Dimmed="{Binding IsDimmed}"
                                  Margin="0,0,3,0" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PartRowViewModel}">
            <Grid Margin="0,3,0,0" Opacity="{Binding RowOpacity}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                        CornerRadius="1" Margin="0,1,0,1" MinHeight="20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFB8995F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSeverable}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brushes.AccentSever}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                    <Setter Property="Background" Value="#FF596466" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsQurio}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brushes.AccentQurio}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BreakFlash}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.35"
                                                                 Duration="0:0:0.2"
                                                                 AutoReverse="True"
                                                                 RepeatBehavior="3x" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Grid Grid.Row="0" Grid.Column="1" Margin="5,0,0,2">
                    <Grid.ColumnDefinitions>
                    <!-- 70px fits 「右前肢（丝）」at Small; 44px truncated to look like duplicate 「右前肢」 -->
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               ToolTip="{Binding Name}"
                               FontSize="{DynamicResource Fonts.Size.Small}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brushes.ForegroundMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecommendedTarget}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsQurio}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brushes.AccentQurio}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               FontSize="9"
                               VerticalAlignment="Center"
                               Margin="2,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFD0B778" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brushes.ForegroundMuted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsQurio}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brushes.AccentQurio}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BreakFlash}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brushes.AccentBreak}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Text" Value="破坏!" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl Grid.Column="2"
                                  ItemsSource="{Binding WeakElements}"
                                  VerticalAlignment="Center"
                                  Height="16"
                                  Visibility="{Binding HasWeakElements, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ElementChip Element="{Binding}"
                                                      Small="True"
                                                      Highlighted="True"
                                                      Margin="0,0,2,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="3"
                               Text="{Binding HealthText}"
                               Foreground="{DynamicResource Brushes.ForegroundMuted}"
                               FontSize="9"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               TextAlignment="Right" />
                </Grid>

                <!-- Dual rails: upper flinch (2px), lower break/qurio/sever (3px). -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,0">
                    <Border Height="2"
                            Margin="0,0,0,2"
                            Background="#1A222C"
                            CornerRadius="1"
                            Visibility="{Binding ShowFlinchBar, Converter={StaticResource BoolToVis}}">
                        <Border Background="#B8C0CC"
                                Opacity="0.75"
                                CornerRadius="1"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding FlinchRatio}" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <Border Height="3"
                            Background="#1A222C"
                            CornerRadius="1"
                            Visibility="{Binding ShowBreakBar, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="1" RenderTransformOrigin="0,0.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brushes.AccentTeal}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSeverable}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brushes.AccentSever}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsQurio}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brushes.AccentQurio}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding HealthRatio}" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <Border Height="3"
                            Background="#FF596466"
                            Opacity="0.5"
                            CornerRadius="1"
                            Visibility="{Binding ShowBrokenRail, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>


        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="PanelRoot"
            Background="{DynamicResource Brushes.PanelBackground}"
            Padding="8,6"
            CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            BorderThickness="1">
        <Border.BorderBrush>
            <SolidColorBrush x:Name="PanelBorderBrush" Color="{DynamicResource Colors.PanelBorder}" />
        </Border.BorderBrush>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding CaptureBannerVisible}" Value="True" />
                            <Condition Binding="{Binding MotionEnabled}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard x:Name="CapturePulse">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                     From="#FF725E39"
                                                     To="#FFC9AA62"
                                                    Duration="0:0:1.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>
                        <MultiDataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="CapturePulse" />
                        </MultiDataTrigger.ExitActions>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding CaptureFlash}" Value="True" />
                            <Condition Binding="{Binding MotionEnabled}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    To="#FFFF4D6D"
                                                    Duration="0:0:0.35"
                                                    AutoReverse="True"
                                                    RepeatBehavior="3x" />
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding StunActive}" Value="True" />
                            <Condition Binding="{Binding MotionEnabled}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard x:Name="StunShakeBoard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-2" To="2"
                                                     Duration="0:0:0.08"
                                                     AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>
                        <MultiDataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="StunShakeBoard" />
                        </MultiDataTrigger.ExitActions>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>


        <StackPanel>
            <!-- 1. Capture banner -->
            <Border Visibility="{Binding CaptureBannerVisible, Converter={StaticResource BoolToVis}}"
                    BorderBrush="#FFC9AA62"
                    BorderThickness="1"
                    Background="#24B8995F"
                    CornerRadius="2"
                    Padding="6,2"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="可捕获"
                           Foreground="#FFE2CA87"
                           FontSize="{DynamicResource Fonts.Size.Body}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </Border>

            <!-- 2. Title + recommend chips; long names ellipsis -->
            <Grid Margin="0,0,0,4" MinWidth="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="48" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           Foreground="{DynamicResource Brushes.Foreground}"
                           FontSize="{DynamicResource Fonts.Size.Title}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding Recommended}"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ElementChip Element="{Binding}"
                                                  Highlighted="True"
                                                  Margin="0,0,3,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Grid.Column="2"
                        CornerRadius="2"
                        Padding="4,1"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding CaptureBadgeVisible, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#26333A44" />
                            <Setter Property="BorderBrush" Value="#303F4854" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CaptureBadgeIsCapturable}" Value="True">
                                    <Setter Property="Background" Value="#24B8995F" />
                                    <Setter Property="BorderBrush" Value="#55B8995F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CaptureBadgeIsAnomaly}" Value="True">
                                    <Setter Property="Background" Value="#24E11D48" />
                                    <Setter Property="BorderBrush" Value="#66E11D48" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding CaptureBadgeText}"
                               FontSize="9">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brushes.ForegroundMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CaptureBadgeIsCapturable}" Value="True">
                                        <Setter Property="Foreground" Value="#FFE0C77F" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CaptureBadgeIsAnomaly}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFF8A80" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Column="3"
                           Text="{Binding HealthPercentText}"
                           Foreground="{DynamicResource Brushes.Foreground}"
                           FontSize="{DynamicResource Fonts.Size.Body}"
                           Typography.NumeralAlignment="Tabular"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 4. HP bar + weaken line (主血条始终红色；部位条另用青色) -->
            <Border x:Name="HpTrack"
                    Height="8"
                    Background="#1A222C"
                    CornerRadius="2"
                    Margin="0,0,0,3"
                    ClipToBounds="True">
                <Grid>
                    <Border Background="{DynamicResource Brushes.AccentHealth}"
                            CornerRadius="2"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding HealthRatio}" />
                        </Border.RenderTransform>
                    </Border>
                    <Border Width="2"
                            Height="8"
                            HorizontalAlignment="Left"
                            Background="#FFFFF1F2"
                            Visibility="{Binding WeakenLineVisible, Converter={StaticResource BoolToVis}}">
                        <Border.Margin>
                            <MultiBinding Converter="{StaticResource FractionToLeftMargin}">
                                <Binding Path="WeakenLinePosition" />
                                <Binding Path="ActualWidth" ElementName="HpTrack" />
                            </MultiBinding>
                        </Border.Margin>
                    </Border>
                </Grid>
            </Border>

            <!-- 5. Numbers -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding HealthNumbersText}"
                           Foreground="{DynamicResource Brushes.ForegroundMuted}"
                           FontSize="{DynamicResource Fonts.Size.Small}"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock Grid.Column="1"
                           Text="已过虚弱线"
                           Foreground="{DynamicResource Brushes.AccentHealth}"
                           FontSize="{DynamicResource Fonts.Size.Small}"
                           Visibility="{Binding PastWeakenLine, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- 6. Status + active stun chip -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,6,0"
                        Padding="5,1"
                        CornerRadius="2"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Brushes.AccentStun}"
                        Background="#33EAB308"
                        VerticalAlignment="Center"
                        Visibility="{Binding StunActive, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StunActive}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="StunPulseBoard">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.42"
                                                                 Duration="0:0:0.45" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="StunPulseBoard" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="晕眩中"
                                   Foreground="{DynamicResource Brushes.AccentStun}"
                                   FontSize="{DynamicResource Fonts.Size.Small}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StunCountdownText}"
                                   Foreground="#FFFFF7CC"
                                   FontSize="{DynamicResource Fonts.Size.Body}"
                                   FontWeight="Bold"
                                   Typography.NumeralAlignment="Tabular"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   MinWidth="28" />
                    </StackPanel>
                </Border>

                <controls:StatusLineText Grid.Column="1"
                                         Text="{Binding StatusLineText}"
                                         VerticalAlignment="Center" />
            </Grid>

            <!-- 7. Parts -->
            <StackPanel Visibility="{Binding ShowParts, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="部位 · 状态 · 弱属性 · 剩余值"
                           Foreground="{DynamicResource Brushes.ForegroundMuted}"
                           FontSize="9"
                           Margin="0,0,0,2" />
                <ItemsControl ItemsSource="{Binding Parts}" Margin="0,0,0,6" />
            </StackPanel>

            <!-- 8. Ailments: one dense text line, no progress bars. -->
            <TextBlock Text="{Binding AilmentsLineText}"
                       Foreground="{DynamicResource Brushes.ForegroundMuted}"
                       FontSize="{DynamicResource Fonts.Size.Small}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding ShowAilmentsLine, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</UserControl>
