<UserControl x:Class="RiseOverlay.UI.Views.MonsterHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RiseOverlay.UI.Controls"
             xmlns:converters="clr-namespace:RiseOverlay.UI.Converters"
             xmlns:domain="clr-namespace:RiseOverlay.Domain;assembly=RiseOverlay.Domain"
             xmlns:vm="clr-namespace:RiseOverlay.UI.ViewModels"
             Width="272"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:FractionToLeftMarginConverter x:Key="FractionToLeftMargin" />

        <DataTemplate DataType="{x:Type vm:ElementDisplayItem}">
            <controls:ElementChip Element="{Binding Element}"
                                  Dimmed="{Binding IsDimmed}"
                                  Margin="0,0,3,0" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PartRowViewModel}">
            <Grid Margin="0,2,0,0" Opacity="{Binding RowOpacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="36" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           Foreground="{StaticResource Brushes.Foreground}"
                           FontSize="{StaticResource Fonts.Size.Small}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,3,0">
                    <Border Visibility="{Binding IsSeverable, Converter={StaticResource BoolToVis}}"
                            Background="#334A9B9B"
                            CornerRadius="1"
                            Padding="3,0"
                            Margin="0,0,2,0">
                        <TextBlock Text="断"
                                   Foreground="{StaticResource Brushes.AccentTeal}"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                    </Border>
                    <Border Visibility="{Binding IsBroken, Converter={StaticResource BoolToVis}}"
                            Background="#33333A44"
                            CornerRadius="1"
                            Padding="3,0">
                        <TextBlock Text="破"
                                   Foreground="{StaticResource Brushes.ForegroundMuted}"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <TextBlock Text="弱"
                               Foreground="{StaticResource Brushes.ForegroundMuted}"
                               FontSize="9"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0" />
                    <ItemsControl ItemsSource="{Binding WeakElements}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ElementChip Element="{Binding}"
                                                      Small="True"
                                                      Margin="0,0,2,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Column="3"
                        Height="4"
                        VerticalAlignment="Center"
                        Background="#1A222C"
                        CornerRadius="1"
                        Margin="0,0,4,0">
                    <Border Background="{StaticResource Brushes.AccentTeal}"
                            CornerRadius="1"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding HealthRatio}" />
                        </Border.RenderTransform>
                    </Border>
                </Border>

                <TextBlock Grid.Column="4"
                           Text="{Binding HealthText}"
                           Foreground="{StaticResource Brushes.ForegroundMuted}"
                           FontSize="9"
                           VerticalAlignment="Center"
                           MinWidth="52"
                           TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AilmentRowViewModel}">
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding DisplayName}"
                           Foreground="{StaticResource Brushes.Foreground}"
                           FontSize="{StaticResource Fonts.Size.Small}"
                           VerticalAlignment="Center" />

                <Border Grid.Column="1"
                        Height="4"
                        VerticalAlignment="Center"
                        Background="#1A222C"
                        CornerRadius="1"
                        Margin="0,0,4,0">
                    <Border Background="{StaticResource Brushes.AccentTeal}"
                            CornerRadius="1"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding BarRatio}" />
                        </Border.RenderTransform>
                    </Border>
                </Border>

                <TextBlock Grid.Column="2"
                           Text="{Binding ValueText}"
                           Foreground="{StaticResource Brushes.ForegroundMuted}"
                           FontSize="9"
                           VerticalAlignment="Center"
                           MinWidth="32"
                           TextAlignment="Right" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="PanelRoot"
            Background="{StaticResource Brushes.PanelBackground}"
            Padding="8,6"
            CornerRadius="2"
            BorderThickness="1">
        <Border.BorderBrush>
            <SolidColorBrush x:Name="PanelBorderBrush" Color="#FF2A2F38" />
        </Border.BorderBrush>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CaptureBannerVisible}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="CapturePulse">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    From="#FF2A6B6B"
                                                    To="#FF4A9B9B"
                                                    Duration="0:0:1.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="CapturePulse" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <!-- 1. Capture banner -->
            <Border Visibility="{Binding CaptureBannerVisible, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{StaticResource Brushes.AccentTeal}"
                    BorderThickness="1"
                    Background="#1A4A9B9B"
                    CornerRadius="2"
                    Padding="6,2"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="可捕获"
                           Foreground="{StaticResource Brushes.AccentTeal}"
                           FontSize="{StaticResource Fonts.Size.Body}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </Border>

            <!-- 2. Title -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           Foreground="{StaticResource Brushes.Foreground}"
                           FontSize="{StaticResource Fonts.Size.Title}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Visibility="{Binding ShowUncapturableBadge, Converter={StaticResource BoolToVis}}"
                        Background="#33333A44"
                        CornerRadius="2"
                        Padding="4,1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="不可捕"
                               Foreground="{StaticResource Brushes.ForegroundMuted}"
                               FontSize="{StaticResource Fonts.Size.Small}" />
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{Binding HealthPercentText}"
                           Foreground="{StaticResource Brushes.Foreground}"
                           FontSize="{StaticResource Fonts.Size.Body}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 3. Weakness + Recommend -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="弱"
                           Foreground="{StaticResource Brushes.ForegroundMuted}"
                           FontSize="{StaticResource Fonts.Size.Small}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding OverallElements}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Grid.Column="2"
                           Text="推荐"
                           Foreground="{StaticResource Brushes.ForegroundMuted}"
                           FontSize="{StaticResource Fonts.Size.Small}"
                           VerticalAlignment="Center"
                           Margin="6,0,4,0" />
                <ItemsControl Grid.Column="3"
                              ItemsSource="{Binding Recommended}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ElementChip Element="{Binding}" Margin="0,0,3,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- 4. HP bar + weaken line -->
            <Border x:Name="HpTrack"
                    Height="8"
                    Background="#1A222C"
                    CornerRadius="2"
                    Margin="0,0,0,3"
                    ClipToBounds="True">
                <Grid>
                    <Border Background="{StaticResource Brushes.AccentTeal}"
                            CornerRadius="2"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding HealthRatio}" />
                        </Border.RenderTransform>
                    </Border>
                    <Border Width="2"
                            Height="8"
                            HorizontalAlignment="Left"
                            Background="#FF5EC8C8"
                            Visibility="{Binding WeakenLineVisible, Converter={StaticResource BoolToVis}}">
                        <Border.Margin>
                            <MultiBinding Converter="{StaticResource FractionToLeftMargin}">
                                <Binding Path="WeakenLinePosition" />
                                <Binding Path="ActualWidth" ElementName="HpTrack" />
                            </MultiBinding>
                        </Border.Margin>
                    </Border>
                </Grid>
            </Border>

            <!-- 5. Numbers -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding HealthNumbersText}"
                           Foreground="{StaticResource Brushes.ForegroundMuted}"
                           FontSize="{StaticResource Fonts.Size.Small}" />
                <TextBlock Grid.Column="1"
                           Text="已过虚弱线"
                           Foreground="{StaticResource Brushes.AccentTeal}"
                           FontSize="{StaticResource Fonts.Size.Small}"
                           Visibility="{Binding PastWeakenLine, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- 6. Status line -->
            <controls:StatusLineText Text="{Binding StatusLineText}" Margin="0,0,0,6" />

            <!-- 7. Parts -->
            <TextBlock Text="弱× = 属性弱点（非吸收）"
                       Foreground="{StaticResource Brushes.ForegroundMuted}"
                       FontSize="9"
                       Margin="0,0,0,2" />
            <ItemsControl ItemsSource="{Binding Parts}" Margin="0,0,0,6" />

            <!-- 8. Ailments -->
            <ItemsControl ItemsSource="{Binding Ailments}" />
        </StackPanel>
    </Border>
</UserControl>
