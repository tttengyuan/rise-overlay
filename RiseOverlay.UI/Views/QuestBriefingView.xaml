<UserControl x:Class="RiseOverlay.UI.Views.QuestBriefingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RiseOverlay.UI.Controls"
             xmlns:vm="clr-namespace:RiseOverlay.UI.ViewModels"
             Width="300"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:ElementDisplayItem}">
            <controls:ElementChip Element="{Binding Element}"
                                  Dimmed="{Binding IsDimmed}"
                                  Margin="0,0,4,0" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:QuestBriefingTargetViewModel}">
            <StackPanel Margin="0,0,0,2">
                <TextBlock Text="{Binding Name}"
                           Foreground="{DynamicResource Brushes.Foreground}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,8" />

                <!-- Single baseline: larger chips, no forced 16px clamp -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center">
                    <TextBlock Text="弱"
                               Foreground="{DynamicResource Brushes.ForegroundMuted}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ItemsControl ItemsSource="{Binding OverallElements}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border Width="1"
                            Height="14"
                            Margin="8,0"
                            Background="{DynamicResource Brushes.PanelBorderSubtle}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="推荐"
                               Foreground="{DynamicResource Brushes.ForegroundMuted}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ItemsControl ItemsSource="{Binding Recommended}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ElementChip Element="{Binding}"
                                                      Highlighted="True"
                                                      Margin="0,0,4,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Background="#334A9B9B"
                            CornerRadius="3"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturable}" Value="False">
                                        <Setter Property="Background" Value="#33333A44" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CaptureChipText}"
                                   FontSize="11"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brushes.AccentTeal}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturable}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Brushes.ForegroundMuted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Border Visibility="{Binding HasSeverableTail, Converter={StaticResource BoolToVis}}"
                            Background="#334A9B9B"
                            CornerRadius="3"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="断尾"
                                   Foreground="{DynamicResource Brushes.AccentTeal}"
                                   FontSize="11" />
                    </Border>

                    <Border Visibility="{Binding ShowFocusPart, Converter={StaticResource BoolToVis}}"
                            Background="#33333A44"
                            CornerRadius="3"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding FocusPartLabel}"
                                   Foreground="{DynamicResource Brushes.ForegroundMuted}"
                                   FontSize="11" />
                    </Border>
                </StackPanel>

                <Rectangle Height="1"
                           Margin="0,10,0,10"
                           Stroke="{DynamicResource Brushes.PanelBorder}"
                           StrokeThickness="1"
                           StrokeDashArray="2 2"
                           SnapsToDevicePixels="True"
                           Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brushes.PanelBackground}"
            Padding="14,12"
            CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            BorderBrush="{DynamicResource Brushes.PanelBorder}"
            BorderThickness="1">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="任务简报"
                           Foreground="{DynamicResource Brushes.Foreground}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TargetCountText}"
                           Foreground="{DynamicResource Brushes.ForegroundMuted}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <Rectangle Height="1"
                       Margin="0,0,0,10"
                       Fill="{DynamicResource Brushes.PanelBorder}"
                       SnapsToDevicePixels="True" />

            <ItemsControl ItemsSource="{Binding Targets}" />
        </StackPanel>
    </Border>
</UserControl>
