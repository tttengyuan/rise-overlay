<UserControl x:Class="RiseOverlay.UI.Views.CombatStackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RiseOverlay.UI.Views"
             Width="272"
             Focusable="False"
             IsTabStop="False">
    <StackPanel>
        <!-- Prefer VM shape with MonsterHud / DpsPanel (RiseCompactMonsterViewModel); playground may override child DataContext. -->
        <views:MonsterHudView x:Name="MonsterHud" DataContext="{Binding MonsterHud}" />
        <views:DpsPanelView x:Name="DpsPanel" DataContext="{Binding DpsPanel}" Margin="0,5,0,0" />
    </StackPanel>
</UserControl>
