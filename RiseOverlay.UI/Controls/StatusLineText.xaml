<UserControl x:Class="RiseOverlay.UI.Controls.StatusLineText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False">
    <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{DynamicResource Brushes.ForegroundMuted}"
               FontSize="{DynamicResource Fonts.Size.Small}"
               TextTrimming="CharacterEllipsis"
               TextWrapping="NoWrap" />
</UserControl>
