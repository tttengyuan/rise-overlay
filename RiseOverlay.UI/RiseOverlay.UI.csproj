<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RiseOverlay.UI</RootNamespace>
    <AssemblyName>RiseOverlay.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\rise-hp-icon.png" />
    <!-- 怪物图标（112 张 64px，由 Scripts/gen_monster_icons.py 生成，供 MonsterIcons.xaml 的 pack URI 引用） -->
    <Resource Include="Resources\Monsters\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RiseOverlay.Domain\RiseOverlay.Domain.csproj" />
    <ProjectReference Include="..\RiseOverlay.Data\RiseOverlay.Data.csproj" />
    <ProjectReference Include="..\HunterPie.Core\HunterPie.Core.csproj" />
    <ProjectReference Include="..\HunterPie.UI\HunterPie.UI.csproj" />
  </ItemGroup>

</Project>
