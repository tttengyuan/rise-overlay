<Window x:Class="RiseOverlay.UI.Update.RiseUpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rise Overlay 更新"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D1118"
        Foreground="#E8ECF1"
        FontFamily="Segoe UI"
        ShowInTaskbar="True"
        Topmost="True">
    <Border Padding="22"
            BorderBrush="#2A303C"
            BorderThickness="1"
            Background="#121820">
        <StackPanel>
            <TextBlock Text="建议立即更新"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#5ECFC4"
                       Margin="0,0,0,10" />
            <TextBlock x:Name="VersionText"
                       FontSize="13"
                       Foreground="#C5CCD6"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />
            <TextBlock Text="新版本包含计时与伤害统计修复。更新后会自动重启软件；狩猎中请先结束或稍后更新。"
                       FontSize="12.5"
                       Foreground="#8B93A1"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       LineHeight="18" />
            <Border Background="#0A0E14"
                    BorderBrush="#2A303C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    MaxHeight="140"
                    Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText"
                               FontSize="12"
                               Foreground="#A8B0BC"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="稍后"
                        Width="88"
                        Height="32"
                        Margin="0,0,10,0"
                        Click="OnLaterClick"
                        Background="#1A2030"
                        Foreground="#C5CCD6"
                        BorderBrush="#3A4250"
                        Cursor="Hand" />
                <Button Content="立即更新"
                        Width="104"
                        Height="32"
                        Click="OnUpdateClick"
                        Background="#1A3A3A"
                        Foreground="#5ECFC4"
                        BorderBrush="#5ECFC4"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
